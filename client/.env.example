# Client endpoint configuration (Vite). Copy to `.env.local` (local) or
# `.env.production.local` (cloud build); real `.env.*` files are gitignored.
# Nothing here is secret — never put HOST_KEY or tokens in client configuration.

# Where the Colyseus server is (HTTP(S) base; the SDK switches to WS/WSS itself).
# Leave UNSET when the Colyseus server also serves this built client (same origin),
# which is how the local preview and the tunnel preview run.
#   Local dev (vite on :5173):    detected automatically as http://<host>:2567
#   Colyseus Cloud:               VITE_SERVER_URL=https://<your-app>.<region>.colyseus.cloud
# VITE_SERVER_URL=

# The address phones should open (used for the host console's QR code) when the
# page is served from somewhere other than where players will load it.
# VITE_PUBLIC_URL=https://<where-phones-open-the-game>
