#!/bin/bash
# Run a Blender script with the bpy module set up by tools/blender/setup-cloud.sh, taking the same
# arguments as `blender --background --python SCRIPT -- ARGS`:
#   tools/blender/blender-py tools/blender/build_guest_suite.py -- --out=/tmp/gs --only=room_level --res=25
exec "${BPY_VENV:-/opt/bpy-venv}/bin/python" - "$@" <<'PY'
import runpy, sys
import bpy  # noqa: F401  (makes bmesh and mathutils importable)
script = sys.argv[1]
sys.argv = ["blender", "--background", "--python", script, *sys.argv[2:]]
runpy.run_path(script, run_name="__main__")
PY
